{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kartik-agarwal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "kartik-agarwal.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kartik-agarwal.com",
      "custom_domain": true
    }
  ]
}
